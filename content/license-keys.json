{
  "collection": "license-keys",
  "label": "License keys",
  "description": "Keys given to buyers, and imported keys waiting to be sold.",
  "fields": [
    {
      "id": "key",
      "label": "Key",
      "type": "text",
      "required": true
    },
    {
      "id": "product",
      "label": "Product",
      "type": "product_lookup",
      "key": "product_id",
      "required": true
    },
    {
      "id": "status",
      "label": "Status",
      "type": "select",
      "default": "available",
      "options": [
        { "value": "available", "label": "Available" },
        { "value": "assigned", "label": "Assigned" },
        { "value": "revoked", "label": "Revoked" }
      ]
    },
    {
      "id": "source",
      "label": "Source",
      "type": "select",
      "readonly": true,
      "options": [
        { "value": "pool", "label": "Imported" },
        { "value": "generated", "label": "Generated" }
      ]
    },
    {
      "id": "order",
      "label": "Order",
      "type": "lookup",
      "model": "orders",
      "key": "order_id",
      "readonly": true
    },
    {
      "id": "activation_limit",
      "label": "Activation limit",
      "type": "integer",
      "min": 1,
      "description": "Empty means unlimited"
    },
    {
      "id": "activations",
      "label": "Activations",
      "type": "json",
      "readonly": true,
      "description": "Devices or sites the key is active on, recorded by the license API"
    },
    {
      "id": "date_expires",
      "label": "Valid until",
      "type": "datetime",
      "description": "Empty means the key never expires"
    },
    {
      "id": "date_assigned",
      "label": "Assigned",
      "type": "datetime",
      "readonly": true
    }
  ],
  "views": [
    {
      "id": "list",
      "nav": {
        "parent": "products",
        "label": "License keys"
      },
      "fields": [
        { "id": "key" },
        { "id": "product" },
        { "id": "status" },
        { "id": "order" },
        { "id": "date_expires" }
      ],
      "tabs": [
        { "id": "available", "label": "Available", "query": { "status": "available" } },
        { "id": "assigned", "label": "Assigned", "query": { "status": "assigned" } },
        { "id": "revoked", "label": "Revoked", "query": { "status": "revoked" } }
      ]
    },
    {
      "id": "edit",
      "fields": [
        { "id": "key" },
        {
          "type": "field_row",
          "fields": [{ "id": "product" }, { "id": "status" }]
        },
        {
          "type": "field_row",
          "fields": [{ "id": "source" }, { "id": "order" }]
        },
        {
          "type": "field_row",
          "fields": [{ "id": "activation_limit" }, { "id": "date_expires" }]
        },
        { "id": "activations" },
        { "id": "date_assigned" }
      ]
    }
  ]
}
